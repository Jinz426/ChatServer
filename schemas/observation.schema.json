{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Global World Observation",
  "type": "object",
  "required": ["id", "observed_at", "location", "category", "evidence"],
  "properties": {
    "id": {"type": "string"},
    "observed_at": {"type": "string", "format": "date-time"},
    "location": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "accuracy_m": {"type": "number", "minimum": 0}
      }
    },
    "category": {
      "type": "string",
      "enum": ["residential", "commercial", "market", "industrial", "agriculture", "infrastructure", "transport", "product", "environment", "other"]
    },
    "data": {"type": "object"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "status"],
        "properties": {
          "kind": {"type": "string"},
          "source": {"type": "string"},
          "status": {"enum": ["observed", "sourced", "derived", "inferred", "unknown"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
